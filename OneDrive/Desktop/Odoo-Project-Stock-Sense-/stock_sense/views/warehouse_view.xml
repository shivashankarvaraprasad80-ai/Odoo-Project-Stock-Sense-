<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_sense_warehouse_tree" model="ir.ui.view">
        <field name="name">stock_sense.warehouse.tree</field>
        <field name="model">stock_sense.warehouse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="action_stock_sense_warehouse" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">stock_sense.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_warehouse_config" name="Warehouses" parent="menu_stock_sense_config" action="action_stock_sense_warehouse" sequence="1"/>

    <record id="view_stock_sense_location_tree" model="ir.ui.view">
        <field name="name">stock_sense.location.tree</field>
        <field name="model">stock_sense.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <record id="action_stock_sense_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">stock_sense.location</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_location_config" name="Locations" parent="menu_stock_sense_config" action="action_stock_sense_location" sequence="2"/>
</odoo>
